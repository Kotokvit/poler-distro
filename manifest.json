{
  "distro_name": "POLER CachyOS Sovereign Edition",
  "base_os": "CachyOS Linux x86_64",
  "version": "1.0.0",
  "upstream_kernel": "linux-cachyos",
  "core_stack": {
    "init": "poler-init (PID 1 boot supervisor)",
    "shell": "poler-sh (Sovereign Shell & AST Math Gateway)",
    "archive": "poler (FastCDC + BLAKE3 Streaming Deduplication)",
    "box": "poler-box (Kernel Sandbox & Seccomp Isolation)",
    "fuse": "poler-fuse (Zero-overhead VFS mounter)",
    "updater": "poler-update (Direct GitHub Mirror Sync)"
  },
  "optional_modules": {
    "engine": "poler-engine (Quantum, MCP, Living Voice, 3D Rasterizer)",
    "mesh": "poler-mesh (Sovereign Node Mesh Hub)",
    "git": "poler-git (Unified Git Engine)",
    "edit": "poler-edit (Sovereign Text/Code Editor)"
  },
  "legacy_purged": [
    "/bin/bash (replaced by poler-sh)",
    "/usr/bin/bash (symlinked to poler-sh)",
    "SysVinit shell script glue",
    "Slow systemd shell generators"
  ],
  "update_mirror": {
    "github_repo": "Kotokvit/poler-distro",
    "api_endpoint": "https://api.github.com/repos/Kotokvit/poler-distro/releases/latest",
    "raw_endpoint": "https://raw.githubusercontent.com/Kotokvit/poler-distro/main"
  }
}
